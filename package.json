{
  "name": "sales-and-fields-ops-os-back",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:types": "supabase gen types --lang typescript --linked --schema public > src/types/database.ts",
    "test": "vitest run src",
    "test:db": "bash scripts/test-db.sh",
    "test:integration": "vitest run supabase/tests/integration --no-file-parallelism",
    "dev:test": "wrangler dev --env test --port ${TEST_WORKER_PORT:-8788}",
    "stack:test:start": "SUPABASE_EXPERIMENTAL_STACK=1 supabase stack start --stack test",
    "stack:test:status": "SUPABASE_EXPERIMENTAL_STACK=1 supabase stack status --stack test",
    "stack:test:stop": "SUPABASE_EXPERIMENTAL_STACK=1 supabase stack stop --stack test",
    "test:integration:full": "bash scripts/test-integration.sh",
    "test:all": "npm run typecheck && npm test && npm run test:db && npm run test:integration:full",
    "db:test:migrate": "bash scripts/migrate-test.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "start-server-and-test": "3.0.13",
    "supabase": "^3.1.0-beta.26",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.153.0"
  },
  "dependencies": {
    "@supabase/middleware": "^1.0.0",
    "@supabase/server": "^1.9.2",
    "@supabase/supabase-js": "^2.118.0",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  }
}
